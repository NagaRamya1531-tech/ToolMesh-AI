# Local sandbox only. Use URL-safe passwords in this Compose configuration.
POSTGRES_PASSWORD=local_migration_password
TOOLMESH_APP_PASSWORD=local_app_password
API_PORT=8000
WEB_PORT=5173
# Sandbox-only credentials. Set before the first M1 migration.
TOOLMESH_PAYMENTS_DB_PASSWORD=local_payments_db_password
TOOLMESH_SUPPORT_DB_PASSWORD=local_support_db_password
TOOLMESH_PAYMENTS_SECRET=local_payments_gateway_key
TOOLMESH_SUPPORT_SECRET=local_support_gateway_key
TOOLMESH_ADMIN_PASSWORD=local_admin_password
TOOLMESH_SUPPORT_PASSWORD=local_support_password
TOOLMESH_PAYMENTS_PASSWORD=local_payments_password
TOOLMESH_COMMUNICATION_DB_PASSWORD=local_communication_db_password
TOOLMESH_COMMUNICATION_SECRET=local_communication_gateway_key
TOOLMESH_FINANCE_PASSWORD=local_finance_password
TOOLMESH_APPROVER_PASSWORD=local_approver_password
TOOLMESH_INVENTORY_DB_PASSWORD=local_inventory_db_password
TOOLMESH_INVENTORY_SECRET=local_inventory_gateway_key
TOOLMESH_IT_DB_PASSWORD=local_it_db_password
TOOLMESH_IT_SECRET=local_it_gateway_key
TOOLMESH_IT_PASSWORD=local_it_agent_password

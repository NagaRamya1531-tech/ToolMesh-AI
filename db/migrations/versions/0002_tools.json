{
  "payments.get_transaction": {
    "description": "Retrieve a captured transaction.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Transaction Id",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "transaction_id"
      ],
      "title": "TransactionLookup",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "order_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "amount_minor": {
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "installment": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Installment"
        }
      },
      "required": [
        "id",
        "order_id",
        "customer_id",
        "amount_minor",
        "currency",
        "status",
        "installment"
      ],
      "title": "Transaction",
      "type": "object"
    },
    "risk": "read"
  },

  "it.get_system_logs": {
    "description": "Read timestamped simulated logs by severity.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Customer Id",
          "type": "string"
        },

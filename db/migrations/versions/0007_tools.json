          "type": "string"
        },
        "level": {
          "enum": [
            "INFO",
            "WARN",
            "ERROR"
          ],
          "title": "Level",
          "type": "string"
        },
        "limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "customer_id",
        "service_id",
        "level",
        "limit"
      ],
      "title": "LogQuery",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "Log": {
          "additionalProperties": false,
          "properties": {
            "timestamp": {
              "title": "Timestamp",
              "type": "string"
            },
            "level": {
              "title": "Level",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "timestamp",
            "level",
            "message"
          ],
          "title": "Log",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "logs": {
          "items": {
            "$ref": "#/$defs/Log"
          },
          "title": "Logs",
          "type": "array"
        }
      },
      "required": [
        "logs"
      ],
      "title": "Logs",
      "type": "object"
    },
    "risk": "read"
  },

{
  "payments.issue_refund": {
    "description": "Request a sandbox refund with human approval.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Transaction Id",
          "type": "string"
        },
        "amount_minor": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "transaction_id",
        "amount_minor",
        "currency"
      ],
      "title": "RefundIntent",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Customer Id",
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9-]+$",
          "title": "Transaction Id",
          "type": "string"
        },
        "amount_minor": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Amount Minor",
          "type": "integer"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "customer_id",
        "transaction_id",
        "amount_minor",
        "currency",
        "id",
        "status"
      ],
      "title": "Refund",
      "type": "object"
    },
    "risk": "approval"
  },
